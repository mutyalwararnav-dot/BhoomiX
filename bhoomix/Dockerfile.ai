FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY training/requirements-rooftop.txt training/requirements-elevation.txt ./training/
RUN python3 -m pip install --break-system-packages --no-cache-dir \
    -r training/requirements-rooftop.txt -r training/requirements-elevation.txt

COPY training ./training
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "training.inference_service:app", "--host", "0.0.0.0", "--port", "8000"]
