# Public Supabase project settings. Copy these values from
# Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Deployed application origin used to reject cross-site browser mutations.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required by server API routes after RLS migration 07. Keep this value secret.
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Optional server-only model service. Leave AI_INFERENCE_URL unset for manual
# boundary review; BhoomiX will not invent demo predictions. Never prefix the
# API key with NEXT_PUBLIC_.
# AI_INFERENCE_URL=http://127.0.0.1:8000/predict
# AI_INFERENCE_API_KEY=replace-with-a-private-service-key
# AI_INFERENCE_TIMEOUT_MS=120000
# AI_MODEL_VERSION=bhoomix-rooftop-unet-v1
# ROOFTOP_MODEL_THRESHOLD=0.50
# ROOFTOP_MODEL_MIN_AREA=300
# ROOFTOP_MODEL_TILE_SIZE=1024
